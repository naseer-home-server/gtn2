# Deployment Docker Compose configuration.
# Local development: pnpm setup:local generates ignored .env.local plus backend/frontend .env files.
# Use pnpm db:up/db:down to select this checkout's Compose project and persistent volume.
APP_URL=https://gtn2.example.com
SUPERTOKENS_CONNECTION_URI=
SUPERTOKENS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SUPERTOKENS_DASHBOARD_ADMINS=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# AI simulation console. Set two distinct, random secrets of at least 32 characters.
# Human play and AI simulation share the active game session; run one at a time.
SIMULATION_SERVICE_KEY=
SIMULATION_OPERATOR_TOKEN=
SIMULATION_PORT=3010
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
SIM_HOST_MODEL=
SIM_PLAYER_MODEL=
# Optional when the provider publishes context_length in GET /models; required otherwise.
SIM_HOST_CONTEXT_TOKENS=0
SIM_PLAYER_CONTEXT_TOKENS=0
# Model output maxima are discovered automatically; set documented maxima only if metadata is unavailable.
SIM_HOST_MAX_OUTPUT_TOKENS=0
SIM_PLAYER_MAX_OUTPUT_TOKENS=0
