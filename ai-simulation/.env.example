# Server-only secrets. Never add these to frontend variables.
SIMULATION_OPERATOR_TOKEN=change-me-to-a-long-random-secret
SIMULATION_SERVICE_KEY=must-match-the-simulation-backend-key
SIMULATION_DATA_DIR=./data
SIMULATION_PUBLIC_DIR=./frontend/dist
GAME_API_BASE_URL=http://127.0.0.1:3000

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
SIM_HOST_MODEL=
SIM_PLAYER_MODEL=
# 0 discovers compatible-provider metadata; otherwise set each model's documented context window.
SIM_HOST_CONTEXT_TOKENS=0
SIM_PLAYER_CONTEXT_TOKENS=0
SIM_MAX_CONCURRENCY=5
# Automatic output maximum from model metadata. For providers without metadata,
# set each model's documented maximum here (not a custom response cap).
SIM_HOST_MAX_OUTPUT_TOKENS=0
SIM_PLAYER_MAX_OUTPUT_TOKENS=0
