# pnpm setup:local generates .env with unique ports and a local Docker database.
PORT=3000
APP_URL=http://localhost:5173
# Set LOCAL=true to use the shared SuperTokens Core's local email/password accounts.
LOCAL=true
SUPERTOKENS_CONNECTION_URI=http://127.0.0.1:1233
SUPERTOKENS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails allowed to use /auth/dashboard.
# Dashboard access is separate from the game's admin role.
SUPERTOKENS_DASHBOARD_ADMINS=
DATABASE_URL=postgresql://gtn2:gtn2@127.0.0.1:55432/gtn2
# Optional AI simulation bridge; use the same random secret in ai-simulation/.env.
SIMULATION_SERVICE_KEY=
