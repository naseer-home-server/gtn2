{
  "name": "backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "files": [
    "dist",
    "public",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --import tsx --test src/*.test.ts src/engine/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/seed-test-data.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@trpc/server": "^11.18.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "express": "^4.22.2",
    "pg": "^8.23.1",
    "supertokens-node": "^24.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2"
  },
  "exports": {
    "./engine": {
      "types": "./src/engine/index.ts",
      "import": "./dist/engine/index.js"
    },
    "./game": {
      "types": "./src/engine/types.ts"
    },
    "./router": {
      "types": "./src/router.ts"
    },
    "./chats": {
      "types": "./src/chat-types.ts"
    }
  }
}
