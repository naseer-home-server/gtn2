{
  "name": "game-theory-night-2",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "node scripts/local.mjs dev",
    "build": "pnpm --filter game build",
    "docker:dev": "docker compose up --build",
    "docker:prod": "docker compose up -d --build",
    "setup:local": "node scripts/local.mjs setup",
    "db:up": "node scripts/local.mjs db:up",
    "db:down": "node scripts/local.mjs db:down",
    "db:seed": "node scripts/local.mjs db:seed",
    "test:db": "node scripts/local.mjs test:db",
    "local:info": "node scripts/local.mjs info",
    "test:local": "node --test scripts/local.test.mjs"
  }
}
